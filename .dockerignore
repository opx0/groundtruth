# The build needs source and lockfile. Everything below either cannot enter a
# production image or would invalidate the layer cache on every run.
.git
.next
node_modules
test-results
playwright-report
.dev
docs
tests
# Scratch checkouts left by agents or tooling: 496MB of build context that
# nothing in the image reads.
.delta
.claude
.env
.env.local
*.log
