# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules/
.next/
test-results/
playwright-report/
.env*
!.env.example
*.tsbuildinfo
next-env.d.ts

# Harness-managed workflow scripts. The durable record of how a unit was
# briefed lives in .dev/briefs/; this directory is scaffolding.
.claude/

# Lockfiles for package managers this repo does not use. `package.json` pins
# bun and `bun.lock` is the committed one; a stray pnpm or npm lockfile only
# confuses tooling.
pnpm-lock.yaml
package-lock.json
yarn.lock

# Scratch checkouts left by agents or tooling. Never this repo's source.
.delta/
